# Separate git repos / third-party code (not part of this repo)
pytorch_geometric/
# authors' code: no license, read-only reference, never committed
reference/

# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Data, checkpoints, logs (large; results/ CSVs ARE committed)
data/
checkpoints/
runs/
*.pt
*.ckpt

# LaTeX build output
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
# ...but experiment logs are committed (they hold per-epoch scores)
!experiments/results/**/logs/*.log
